{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ofia-admin-frontend": {
      "root": "ofia_admin",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "ofia-service-users",
          "format": "url",
          "env": "USER_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-ai",
          "format": "url",
          "env": "AI_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-marketplace",
          "format": "url",
          "env": "MARKETPLACE_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-erp",
          "format": "url",
          "env": "ERP_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-logistics",
          "format": "url",
          "env": "LOGISTICS_SERVICE_URL"
        }
      ]
    },
    "ofia-compass-frontend": {
      "root": "ofia_compass",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "ofia-service-users",
          "format": "url",
          "env": "USER_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-ai",
          "format": "url",
          "env": "AI_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-marketplace",
          "format": "url",
          "env": "MARKETPLACE_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-erp",
          "format": "url",
          "env": "ERP_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-logistics",
          "format": "url",
          "env": "LOGISTICS_SERVICE_URL"
        }
      ]
    },
    "ofia-erp-frontend": {
      "root": "ofia_erp",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "ofia-service-users",
          "format": "url",
          "env": "USER_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-ai",
          "format": "url",
          "env": "AI_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-marketplace",
          "format": "url",
          "env": "MARKETPLACE_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-erp",
          "format": "url",
          "env": "ERP_SERVICE_URL"
        },
        {
          "type": "service",
          "service": "ofia-service-logistics",
          "format": "url",
          "env": "LOGISTICS_SERVICE_URL"
        }
      ]
    },
    "ofia-storefront-frontend": {
      "root": "ofia_storefront",
      "framework": "nextjs"
    },
    "ofia-service-ai": {
      "root": "service_ai",
      "framework": "go",
      "runtime": "go",
      "buildCommand": "go build -o server ."
    },
    "ofia-service-erp": {
      "root": "service_erp",
      "framework": "go",
      "runtime": "go",
      "buildCommand": "go build -o server ."
    },
    "ofia-service-logistics": {
      "root": "service_logistics",
      "framework": "go",
      "runtime": "go",
      "buildCommand": "go build -o server ."
    },
    "ofia-service-marketplace": {
      "root": "service_marketplace",
      "framework": "go",
      "runtime": "go",
      "buildCommand": "go build -o server ."
    },
    "ofia-service-users": {
      "root": "service_users",
      "framework": "go",
      "runtime": "go",
      "buildCommand": "go build -o server ."
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/auth/(.*)",
      "destination": {
        "service": "ofia-service-users"
      }
    },
    {
      "source": "/api/v1/organizations/(.*)",
      "destination": {
        "service": "ofia-service-users"
      }
    },
    {
      "source": "/api/v1/organizations",
      "destination": {
        "service": "ofia-service-users"
      }
    },
    {
      "source": "/api/v1/subdomains/(.*)",
      "destination": {
        "service": "ofia-service-users"
      }
    },
    {
      "source": "/api/v1/plans/(.*)",
      "destination": {
        "service": "ofia-service-users"
      }
    },
    {
      "source": "/api/v1/plans",
      "destination": {
        "service": "ofia-service-users"
      }
    },
    {
      "source": "/api/v1/gtm/(.*)",
      "destination": {
        "service": "ofia-service-ai"
      }
    },
    {
      "source": "/api/v1/merchants/(.*)",
      "destination": {
        "service": "ofia-service-marketplace"
      }
    },
    {
      "source": "/api/v1/merchants",
      "destination": {
        "service": "ofia-service-marketplace"
      }
    },
    {
      "source": "/api/v1/disputes/(.*)",
      "destination": {
        "service": "ofia-service-marketplace"
      }
    },
    {
      "source": "/api/v1/layouts/(.*)",
      "destination": {
        "service": "ofia-service-marketplace"
      }
    },
    {
      "source": "/api/v1/layouts",
      "destination": {
        "service": "ofia-service-marketplace"
      }
    },
    {
      "source": "/api/v1/subdomain-layouts/(.*)",
      "destination": {
        "service": "ofia-service-marketplace"
      }
    },
    {
      "source": "/api/v1/subdomain-layouts",
      "destination": {
        "service": "ofia-service-marketplace"
      }
    },
    {
      "source": "/discovery/(.*)",
      "destination": {
        "service": "ofia-service-marketplace"
      }
    },
    {
      "source": "/api/v1/admin/tenants/(.*)",
      "destination": {
        "service": "ofia-service-erp"
      }
    },
    {
      "source": "/api/v1/admin/tenants",
      "destination": {
        "service": "ofia-service-erp"
      }
    },
    {
      "source": "/api/v1/users/(.*)",
      "destination": {
        "service": "ofia-service-erp"
      }
    },
    {
      "source": "/api/v1/users",
      "destination": {
        "service": "ofia-service-erp"
      }
    },
    {
      "source": "/api/v1/departments/(.*)",
      "destination": {
        "service": "ofia-service-erp"
      }
    },
    {
      "source": "/api/v1/departments",
      "destination": {
        "service": "ofia-service-erp"
      }
    },
    {
      "source": "/api/v1/cycles/(.*)",
      "destination": {
        "service": "ofia-service-erp"
      }
    },
    {
      "source": "/api/v1/cycles",
      "destination": {
        "service": "ofia-service-erp"
      }
    },
    {
      "source": "/api/v1/logistics/(.*)",
      "destination": {
        "service": "ofia-service-logistics"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.ofia\\.shop"
        }
      ],
      "destination": {
        "service": "ofia-storefront-frontend"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin\\.ofia\\.ng"
        }
      ],
      "destination": {
        "service": "ofia-admin-frontend"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(food|hotels|hotel|rides|ride|dispatch|beauty|apartments|apartment|shortlets|shortlet|cars|car|laundry|tutors|tutor|autocare|properties|property|home-services|homeservices|fashion-grooming|fashion|professional-services|professionals|education-skills|education|events-entertainment|events|health-wellness|health|logistics-transport|logistics|automotive-services|auto|food-agribusiness|real-estate-construction|realestate|handyman|specialists|cleaning|tech|corporate|creative|talent|tutoring|vocational|planning|entertainment|medical|wellness|caregiving|mechanics|culinary|agriculture|construction|plumber|electrician|carpenter|painter|tiler|welder|solar|solar-installer|generator|generator-repairer|ac-technician|borehole|inverter|tailor|barber|hairdresser|makeup|makeup-artist|nails|lawyer|accountant|cctv|mechanic|car-mechanic|chef|caterer|chauffeur|mover|compass)\\.ofia\\.ng"
        }
      ],
      "destination": {
        "service": "ofia-compass-frontend"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.ofia\\.ng"
        }
      ],
      "destination": {
        "service": "ofia-erp-frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "ofia-storefront-frontend"
      }
    }
  ]
}