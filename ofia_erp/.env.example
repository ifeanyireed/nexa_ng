# ==========================================
# OFIA BUSINESS — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Backend Microservices Base URLs (Proxied via next.config.ts)
USER_SERVICE_URL=https://ofia-user-service.onrender.com
AI_SERVICE_URL=https://ofia-ai-service.onrender.com
MARKETPLACE_SERVICE_URL=https://ofia-marketplace-service.onrender.com
ERP_SERVICE_URL=https://ofia-erp-service.onrender.com
LOGISTICS_SERVICE_URL=https://ofia-logistics-service.onrender.com

# 2. Public API Keys & Settings
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_GOOGLE_MAPS_API_KEY_HERE
NEXT_PUBLIC_APP_URL=http://ofia.ng
NEXT_PUBLIC_ROOT_DOMAIN=ofia.ng
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3005

# 3. Database Configuration (Master Registry & Central User Auth DB)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
USERS_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# 4. Vercel Edge Custom Domain Automation (Optional)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# 5. Multi-Tenant Payment, BYOK Vault & Escrow Configuration (ofia_payments.md)
PAYMENT_VAULT_SECRET=AWAITING_PRODUCTION_VAULT_SECRET
OFIA_MANAGED_PAYSTACK_PUBLIC_KEY=AWAITING_EXTERNAL_PROVIDER_CREDENTIALS
OFIA_MANAGED_PAYSTACK_SECRET_KEY=AWAITING_EXTERNAL_PROVIDER_CREDENTIALS
OFIA_ESCROW_PARTNER_NAME=AWAITING_COMPLIANCE_APPROVAL
OFIA_ESCROW_API_BASE_URL=AWAITING_EXTERNAL_PROVIDER_CREDENTIALS
OFIA_ESCROW_SECRET_KEY=AWAITING_EXTERNAL_PROVIDER_CREDENTIALS
OFIA_ESCROW_WEBHOOK_SECRET=AWAITING_EXTERNAL_PROVIDER_CREDENTIALS
OFIA_ESCROW_SANDBOX_ENABLED=true
