# ==========================================
# OFIA ADMIN — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Backend Microservices Base URLs (Proxied via next.config.ts)
USER_SERVICE_URL=https://ofia-user-service.onrender.com
AI_SERVICE_URL=https://ofia-ai-service.onrender.com
MARKETPLACE_SERVICE_URL=https://ofia-marketplace-service.onrender.com
ERP_SERVICE_URL=https://ofia-erp-service.onrender.com
LOGISTICS_SERVICE_URL=https://ofia-logistics-service.onrender.com

# 2. Public Application Settings
NEXT_PUBLIC_APP_URL=http://admin.ofia.ng
NEXT_PUBLIC_ROOT_DOMAIN=admin.ofia.ng

# 3. Vercel Edge Custom Domain Automation (Optional)
# If provided, custom domains registered during tenant provisioning are automatically attached to Vercel with SSL
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ERP_PROJECT_ID=
VERCEL_TEAM_ID=
